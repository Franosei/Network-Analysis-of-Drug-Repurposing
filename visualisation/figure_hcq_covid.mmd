%% Compact editable figure for the full HCQ-COVID-19 rerun.
flowchart TB
  A["A. Full evidence sources"]
  CT["ClinicalTrials.gov<br/><b>94 canonical trial records</b><br/><small>Full-registry extraction</small>"]
  PM["PubMed / PMC<br/><b>3,391 retrieved; 3,108 exact-pair records</b><br/><small>Open retrieval, exact verification</small>"]
  FDA["openFDA (FAERS)<br/><b>gamma = 0.75; 8 overlapping terms</b><br/><small>Reported-event overlap</small>"]
  NET["Held-out graph<br/><b>2,267 alternative paths; probability 1.000</b><br/><small>Topology is not efficacy</small>"]
  B["B. Meaning-preserving controls"]
  ER["Entity resolution<br/>canonical hydroxychloroquine"]
  DH["Disease harmonisation<br/>COVID-19, MeSH D000086382"]
  EC["Evidence classification<br/><b>893 benefit; 1,271 null/harm/conflicting; 944 irrelevant</b>"]
  SR["Safety reconciliation<br/>8 terms retained as a conflict flag"]
  L["C. Canonical ledger<br/><b>Hydroxychloroquine x COVID-19</b>"]
  POST["Posterior<br/><b>0.2024</b><br/>95% CrI 0.155-0.254"]
  SCORE["Evidence readiness<br/><b>74.9 / 100</b><br/><small>not an efficacy probability</small>"]
  A --> CT
  A --> PM
  A --> FDA
  A --> NET
  CT --> ER --> DH --> EC --> SR --> L
  PM --> EC
  FDA --> SR
  NET --> L
  L --> POST
  L --> SCORE
  classDef trial fill:#E8F1F8,stroke:#2F6690,stroke-width:1.7px
  classDef lit fill:#E8F4F1,stroke:#287A70,stroke-width:1.7px
  classDef safety fill:#FAECEC,stroke:#B44C4C,stroke-width:1.7px
  classDef net fill:#F0ECF8,stroke:#6750A4,stroke-width:1.7px
  classDef control fill:#F7F8FA,stroke:#7C8793,stroke-width:1.2px
  classDef ledger fill:#FFF7E8,stroke:#A66B12,stroke-width:2.2px
  class CT trial
  class PM lit
  class FDA safety
  class NET net
  class ER,DH,EC,SR control
  class L,POST,SCORE ledger
