flowchart LR

    subgraph A[" A.  Evidence sources — same pair, different meanings "]
        direction TB
        SRC_CT["`**ClinicalTrials.gov**
        13 registered trials
        *investigation activity, not efficacy*`"]
        SRC_PM["`**PubMed / PMC**
        40 retrieved records
        *attention, not therapeutic support*`"]
        SRC_FDA["`**openFDA (FAERS)**
        γ = 0.75 safety overlap
        *reported events, not causal effect*`"]
        SRC_NET["`**Drug–disease network**
        0.99 structural consistency
        *proximity, not efficacy*`"]
    end

    subgraph B[" B.  Integration — judgement points, not a simple join "]
        direction LR
        INT_ENTITY["`**Entity resolution**
        HCQ, hydroxychloroquine sulfate
        → one drug entity`"]
        INT_DISEASE["`**Disease harmonisation**
        COVID-19, SARS-CoV-2 infection
        → one disease entity`"]
        INT_CLASS["`**Evidence classification**
        40 records → 20 therapeutic,
        9 adverse, 11 irrelevant`"]
        INT_SAFETY["`**Safety-conflict flag**
        adverse overlap vs.
        therapeutic literature`"]
        INT_ENTITY --> INT_DISEASE --> INT_CLASS --> INT_SAFETY
    end

    SRC_CT --> INT_ENTITY
    SRC_PM --> INT_ENTITY
    SRC_FDA --> INT_ENTITY
    SRC_NET --> INT_ENTITY

    REC(["`**One evidence record**
    hydroxychloroquine × COVID-19`"])
    INT_SAFETY --> REC

    classDef srcTrials fill:#EAF0FA,stroke:#4C72B0,stroke-width:2px,color:#1F1F1F
    classDef srcLit fill:#EAF5EC,stroke:#55A868,stroke-width:2px,color:#1F1F1F
    classDef srcSafety fill:#FBEAEA,stroke:#C44E52,stroke-width:2px,color:#1F1F1F
    classDef srcNetwork fill:#F1EDF7,stroke:#8172B2,stroke-width:2px,color:#1F1F1F
    classDef integ fill:#F7F5F2,stroke:#B7A98C,stroke-width:1.5px,color:#1F1F1F
    classDef merge fill:#FBF7EF,stroke:#946E3D,stroke-width:2px,color:#5B4321

    class SRC_CT srcTrials
    class SRC_PM srcLit
    class SRC_FDA srcSafety
    class SRC_NET srcNetwork
    class INT_ENTITY,INT_DISEASE,INT_CLASS,INT_SAFETY integ
    class REC merge

    style A fill:#FFFFFF,stroke:#DDDDDD,stroke-width:1px
    style B fill:#FFFFFF,stroke:#DDDDDD,stroke-width:1px
