flowchart LR
    subgraph A["A. Evidence sources - same pair, different meanings"]
        direction TB
        SRC_CT["`**ClinicalTrials.gov**
        94 canonical trial records
        *full-registry extraction*`"]
        SRC_PM["`**PubMed / PMC**
        3,391 retrieved; 3,108 exact-pair records
        *complete open retrieval*`"]
        SRC_FDA["`**openFDA (FAERS)**
        gamma = 0.75; eight overlapping terms
        *reported events, not causal effect*`"]
        SRC_NET["`**Held-out drug-disease graph**
        2,267 alternative length-3 paths
        *graph probability = 1.000*`"]
    end
    subgraph B["B. Integration - judgement points"]
        direction LR
        INT_ENTITY["`**Entity resolution**
        Hydroxychloroquine aliases
        -> one canonical drug`"]
        INT_DISEASE["`**Disease harmonisation**
        COVID-19 -> MeSH D000086382
        -> one canonical disease`"]
        INT_CLASS["`**Evidence classification**
        893 benefit; 1,271 null/harm/conflicting
        944 irrelevant`"]
        INT_SAFETY["`**Safety reconciliation**
        Eight overlap terms retained
        as a conflict flag`"]
        INT_ENTITY --> INT_DISEASE --> INT_CLASS --> INT_SAFETY
    end
    SRC_CT --> INT_ENTITY
    SRC_PM --> INT_CLASS
    SRC_FDA --> INT_SAFETY
    SRC_NET --> INT_SAFETY
    REC(["`**Canonical pair**
    hydroxychloroquine x COVID-19`"])
    INT_SAFETY --> REC
